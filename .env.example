# ---------- AI providers (all optional) ----------
# CourtAgent works with no keys at all: it falls back to a built-in rules engine ("offline mode").
# Add one or both keys for AI-assisted extraction, document review and plain-language summaries.
# AI_PROVIDER: auto (default) | anthropic | openai | offline
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# Check the OpenAI model list for a current model name if this one is retired.
OPENAI_MODEL=gpt-4.1-mini

# ---------- Chain (Ethereum Sepolia testnet) ----------
# Address printed by `npm run deploy:sepolia`. Leave empty to use Demo Mode only.
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ---------- Deployment (only needed to deploy the contract) ----------
# Use a throwaway testnet wallet. NEVER put a real-funds key here and never commit this file.
DEPLOYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional second testnet using the same contract:
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
