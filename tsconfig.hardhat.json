{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "preserve",
    "incremental": false,
    "plugins": []
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "artifacts/**/*.d.ts",
    "lib/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "cache",
    "lib/**/*.test.ts"
  ]
}
